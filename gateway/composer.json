{
  "name": "health-agent/coach-gateway",
  "description": "Stateless PHP gateway for the HealthAgent coach",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.2",
    "guzzlehttp/guzzle": "^7.10",
    "openai-php/client": "^0.18",
    "symfony/dotenv": "^7.4",
    "symfony/framework-bundle": "^7.4",
    "symfony/string": "^7.4",
    "symfony/yaml": "^7.4",
    "symfony/validator": "^7.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "symfony/browser-kit": "^7.4",
    "symfony/css-selector": "^7.4"
  },
  "autoload": {"psr-4": {"App\\": "src/"}},
  "autoload-dev": {"psr-4": {"App\\Tests\\": "tests/"}},
  "config": {
    "allow-plugins": {
      "php-http/discovery": true
    }
  },
  "scripts": {
    "test": "phpunit",
    "build:webspace": "bash bin/build-webspace.sh"
  }
}
