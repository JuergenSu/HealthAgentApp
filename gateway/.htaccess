DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Never serve application internals when the whole package is placed below the web root.
    RewriteRule ^(?:config|resources|src|vendor)(?:/|$) - [F,L,NC]
    RewriteRule ^(?:\.env(?:\..*)?|README\.md|composer\.(?:json|lock)|phpunit\.xml(?:\.dist)?)$ - [F,L,NC]

    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    RewriteRule ^ index.php [QSA,L]
</IfModule>

<FilesMatch "(^\.|config\.local\.php$|composer\.(json|lock)$|phpunit\.xml(?:\.dist)?$)">
    Require all denied
</FilesMatch>
